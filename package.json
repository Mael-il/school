{
  "name": "app",
  "productName": "complex-scolaire",
  "version": "1.0.0",
  "description": "Application de bureau pour le suivi des frais scolaires, paiements et rapports financiers.",
  "main": ".vite/build/main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mael-el/school.git"
  },
  "homepage": "https://github.com/Mael-el/school#readme",
  "bugs": {
    "url": "https://github.com/Mael-el/school/issues"
  },
  "scripts": {
    "start": "electron-forge start",
    "start:debug": "ELECTRON_OPEN_DEVTOOLS=1 electron-forge start",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "web:preview": "vite preview --config vite.web.config.ts",
    "web:server": "npm run web:build && node scripts/start-web-server.cjs",
    "prepackage": "npm run web:build",
    "premake": "npm run web:build",
    "dev:clean": "bash scripts/dev-clean.sh",
    "restart": "npm run dev:clean && npm start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "import:excel": "tsx scripts/import-excel.ts",
    "seed:profile": "tsx scripts/seed-profile.ts",
    "seed:fixtures": "tsx scripts/seed-fixtures.ts"
  },
  "keywords": [],
  "author": {
    "name": "Mohamed Nourdine",
    "email": "mohamednjikam25@hotmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "electron": "43.4.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/react-table": "^8.10.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron-squirrel-startup": "^1.0.1",
    "exceljs": "^4.4.0",
    "i18next": "^26.4.0",
    "intl-tel-input": "^29.2.3",
    "kysely": "^0.29.5",
    "lucide-react": "^1.33.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-is": "^19.2.8",
    "react-select": "^5.10.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
